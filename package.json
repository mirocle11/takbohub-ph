{
  "name": "takbohub",
  "version": "0.1.0",
  "private": true,
  "description": "TakboHub - Running Events Management Platform for the Philippines",
  "type": "module",
  "scripts": {
    "dev": "pnpm run --parallel dev:web dev:api",
    "dev:web": "pnpm --filter @takbohub/web dev",
    "dev:api": "pnpm --filter @takbohub/api dev",
    "build": "pnpm run --parallel build:web build:api",
    "build:web": "pnpm --filter @takbohub/web build",
    "build:api": "pnpm --filter @takbohub/api build",
    "lint": "pnpm run -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @takbohub/api prisma:generate",
    "db:migrate": "pnpm --filter @takbohub/api prisma:migrate",
    "db:migrate:dev": "pnpm --filter @takbohub/api prisma:migrate:dev",
    "db:push": "pnpm --filter @takbohub/api prisma:push",
    "db:seed": "pnpm --filter @takbohub/api prisma:seed",
    "db:studio": "pnpm --filter @takbohub/api prisma:studio",
    "db:reset": "pnpm --filter @takbohub/api prisma:reset",
    "clean": "pnpm run -r clean && rm -rf node_modules",
    "typecheck": "pnpm run -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
